Create a new user
sudo useradd -m -s /bin/bash labuser

Set password
echo "labuser:Lab@123" | sudo chpasswd

Add to sudo group (optional for demonstration)
sudo usermod -aG sudo labuser

Verify user exists
cat /etc/passwd | grep labuser


