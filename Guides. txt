## Install a tool 
sudo tee /usr/local/bin/labtool.sh > /dev/null << 'EOF'
#!/bin/bash
echo "Lab tool running"
EOF

Make it executable
sudo chmod +x /usr/local/bin/labtool.sh

Run it
/usr/local/bin/labtool.sh

## Anti forensic

Hide script in a dot directory
sudo mkdir -p /usr/local/.hidden
sudo mv /usr/local/bin/labtool.sh /usr/local/.hidden/
sudo ln -s /usr/local/.hidden/labtool.sh /usr/local/bin/labtool.sh

## Modify Logs
Clear log entries
sudo truncate -s 0 /var/log/syslog

Fake modification time on lab script
sudo touch -t 202512220900 /usr/local/.hidden/labtool.sh

